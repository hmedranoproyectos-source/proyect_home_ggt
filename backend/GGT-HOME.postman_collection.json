    {
      "name": "Entradas de Almacen - pruebas ImportarXML",
      "description": "Endpoint de DIAGNOSTICO POST /api/entradas-almacen/prueba-importacion. Sirve para capturar la respuesta real de ImportarXML (de donde sale el consecutivo de la entrada). NO usa facturas ni escribe en MySQL. Por defecto enviar=false (dry-run: devuelve las lineas y el XML sin llamar a SIESA). Con enviar=true ESCRIBE en SIESA (la conexion Real es PRODUCCION: usar datos de prueba y avisar a contabilidad; el documento queda en estado 0 En Elaboracion). 'overrides' fusiona cualquier campo del plano (ej. f350_consec_docto, F_CONSEC_AUTO_REG, f350_fecha) en todas las lineas. Flujo: 1) Login/Select Company, 2) completar variables de coleccion, 3) dry-run 451, 4) enviar 451 y copiar el consecutivo de resultadoCrudo a la variable consec_docto, 5) dry-run/enviar 470.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "1. 451 Documento - dry-run (no llama a SIESA)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enviar\": false,\n  \"registro\": \"451\",\n  \"parametros\": {\n    \"centro_operacion\": \"{{co}}\",\n    \"tipo_documento\": \"{{tipo_docto}}\",\n    \"bodega\": \"{{bodega}}\",\n    \"motivo\": \"{{motivo}}\",\n    \"centro_operacion_movto\": \"{{co}}\",\n    \"unidad_negocio\": \"{{unidad_negocio}}\",\n    \"centro_costo\": \"{{centro_costo}}\",\n    \"tercero_comprador\": \"{{tercero_comprador}}\",\n    \"moneda\": \"{{moneda}}\"\n  },\n  \"proveedor\": {\n    \"cod_erp\": \"{{cod_erp_proveedor}}\",\n    \"cod_erp_sucursal\": \"{{sucursal_proveedor}}\"\n  },\n  \"factura\": {\n    \"prefijo_fe\": \"PRUEBA\",\n    \"consecutivo_fe\": \"{{consecutivo_prueba}}\"\n  },\n  \"notas\": \"Prueba Postman ImportarXML - borrar\",\n  \"overrides\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/entradas-almacen/prueba-importacion",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "entradas-almacen",
                "prueba-importacion"
              ]
            },
            "description": "Devuelve las lineas y el XML (Clave enmascarada) que se enviarian. No escribe nada."
          }
        },
        {
          "name": "2. 451 Documento - ENVIAR a SIESA (escribe)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enviar\": true,\n  \"registro\": \"451\",\n  \"parametros\": {\n    \"centro_operacion\": \"{{co}}\",\n    \"tipo_documento\": \"{{tipo_docto}}\",\n    \"bodega\": \"{{bodega}}\",\n    \"motivo\": \"{{motivo}}\",\n    \"centro_operacion_movto\": \"{{co}}\",\n    \"unidad_negocio\": \"{{unidad_negocio}}\",\n    \"centro_costo\": \"{{centro_costo}}\",\n    \"tercero_comprador\": \"{{tercero_comprador}}\",\n    \"moneda\": \"{{moneda}}\"\n  },\n  \"proveedor\": {\n    \"cod_erp\": \"{{cod_erp_proveedor}}\",\n    \"cod_erp_sucursal\": \"{{sucursal_proveedor}}\"\n  },\n  \"factura\": {\n    \"prefijo_fe\": \"PRUEBA\",\n    \"consecutivo_fe\": \"{{consecutivo_prueba}}\"\n  },\n  \"notas\": \"Prueba Postman ImportarXML - borrar\",\n  \"overrides\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/entradas-almacen/prueba-importacion",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "entradas-almacen",
                "prueba-importacion"
              ]
            },
            "description": "enviar=true: crea la Entrada de Almacen en estado 0 en SIESA. Revisar la consola de Postman: resultadoCrudo trae la respuesta real de ImportarXML."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "console.log('enviado:', d.enviado, 'ok:', d.ok);",
                  "console.log('errores:', JSON.stringify(d.errores));",
                  "console.log('resultadoCrudo:', JSON.stringify(d.resultadoCrudo, null, 2));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. 470 Detalle - dry-run (no llama a SIESA)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enviar\": false,\n  \"registro\": \"470\",\n  \"consec_docto\": \"{{consec_docto}}\",\n  \"parametros\": {\n    \"centro_operacion\": \"{{co}}\",\n    \"tipo_documento\": \"{{tipo_docto}}\",\n    \"bodega\": \"{{bodega}}\",\n    \"motivo\": \"{{motivo}}\",\n    \"centro_operacion_movto\": \"{{co}}\",\n    \"unidad_negocio\": \"{{unidad_negocio}}\",\n    \"centro_costo\": \"{{centro_costo}}\",\n    \"tercero_comprador\": \"{{tercero_comprador}}\",\n    \"moneda\": \"{{moneda}}\"\n  },\n  \"detalles\": [\n    {\n      \"item\": \"{{item}}\",\n      \"um\": \"{{um}}\",\n      \"um_precio\": \"{{um}}\",\n      \"cantidad\": 1,\n      \"vlr_bruto\": 1000,\n      \"notas\": \"Prueba Postman\"\n    }\n  ],\n  \"overrides\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/entradas-almacen/prueba-importacion",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "entradas-almacen",
                "prueba-importacion"
              ]
            },
            "description": "Requiere la variable consec_docto (consecutivo obtenido en el paso 2)."
          }
        },
        {
          "name": "4. 470 Detalle - ENVIAR a SIESA (escribe)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
