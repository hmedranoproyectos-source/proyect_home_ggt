# Puerto donde escucha la API Express dentro del contenedor
PORT=3001

# ===== MySQL =====
# En docker-compose, DB_HOST=mysql (nombre del servicio); usar los mismos
# valores de MYSQL_USER/MYSQL_PASSWORD/MYSQL_DATABASE definidos en el .env raíz.
DB_HOST=mysql
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=conciliacion-fe

# ===== Redis (broker BullMQ) =====
REDIS_HOST=redis
REDIS_PORT=6379

# ===== Buzón IMAP (config_buzon_fe) =====
IMAP_HOST=
IMAP_PORT=
IMAP_USER=
IMAP_PASSWORD=

# ===== SIESA (Web Services SOAP) =====
SIESA_WSDL_URL=
SIESA_USER=
SIESA_PASSWORD=

# ===== SMTP (alertas de fallas críticas) =====
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ===== BullMQ =====
PORT=3001
BULLMQ_MAX_RETRIES=5
BULLMQ_MAX_RETRIES=5

