# ===== Node.js (backend + worker + frontend) =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
logs/

# ===== Next.js (frontend) =====
.next/
out/

# ===== Variables de entorno =====
# Nunca versionar .env reales; .env.example SÍ debe versionarse.
.env
.env.local
.env.*.local
!.env.example

# ===== Build / dist =====
build/
dist/
coverage/

# ===== Datos locales de MySQL (si se llegan a generar fuera de Docker) =====
mysql-data/
mysql-init/data/
*.ibd
*.frm

# ===== Sistema operativo =====
.DS_Store
Thumbs.db

# ===== IDEs =====
.vscode/
.idea/

# ===== Graphify (grafo de contexto) =====
# Todo lo interno de graphify-out/ se ignora por defecto (cache/, manifest.json,
# cost.json, .graphify_*, respaldos con fecha); solo graph.json, GRAPH_REPORT.md
# y graph.html SÍ se commitean (mapa de contexto compartido).
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.html
